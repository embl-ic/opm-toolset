# build output
/target/

# every folder whose name starts with a dot, at any depth: local toolchains (.tools), scratch
# (.tmp), editor and IDE settings (.vscode, .settings, .idea), tool working folders - none of
# it is source, and none of it is pushed
.*/

# output folders, at any depth: results written while working, never part of the source tree
output/

# Eclipse metadata
/.classpath
/.project

# local tool files
/.cursorrules
/.aider*

# macOS
.DS_Store


# Internal working notes.
#
# Root markdown is internal by default; README.md and project-wide AGENTS.md are the exceptions.
# Other root working notes stay local without maintaining a list of their names.
/*.md
!/README.md
!/AGENTS.md

# internal engineering notes. The published user manual under docs/manual is the exception:
# GitHub Pages can only serve the repository root or /docs, so the site has to live here and be
# committed. Listed as /docs/* plus negations because git cannot re-include a file whose parent
# directory is excluded.
# manual is kept whole, including docs/manual/tools/README.md - that is how the site and the
# screenshot tour are built.
/docs/*
!/docs/manual/
!/docs/index.html

# per-operation logs written next to the data, never part of the source tree
*.log
*.log.lck

# Python bytecode, written beside any script that is imported
__pycache__/

# The Aliasing Resampling evaluation: the study scripts and the report builder behind
# output/aliasing_evaluation and output/pdf. They are not part of the plugin and stay local, like
# the outputs they write. The plugin's own sources, its test and its manual chapter are tracked.
/scripts/aliasing_*.py
/scripts/build_aliasing_report.py
/scripts/opm_aliasing_reconstruction_test.groovy
# its developer-only parity check against the SciPy reconstruction, whose fixtures those scripts write
/src/test/java/de/embl/iclm/AliasingScipyParityTest.java
