# build output
/target/

# every folder whose name starts with a dot, at any depth: local toolchains (.tools), scratch
# (.tmp), editor and IDE settings (.vscode, .settings, .idea), tool working folders - none of
# it is source, and none of it is pushed
.*/

# output folders, at any depth: results written while working, never part of the source tree
output/

# Eclipse metadata
/.classpath
/.project

# local tool files
/.cursorrules
/.aider*

# macOS
.DS_Store


# Only user documentation is published: the manual, its index, the viewer guide and README.md.
# Agent and developer documents and scripts stay local.
#
# Root markdown is internal by default; README.md is the exception.
# Other root working notes stay local without maintaining a list of their names.
/*.md
!/README.md

# internal engineering notes. The published user manual under docs/manual is the exception:
# GitHub Pages can only serve the repository root or /docs, so the site has to live here and be
# committed. Listed as /docs/* plus negations because git cannot re-include a file whose parent
# directory is excluded.
/docs/*
!/docs/manual/
!/docs/index.html
# a public, self-contained user guide served beside the manual
!/docs/online-deskew-viewer-guide.html
# the manual's build and screenshot tools are developer files
/docs/manual/tools/

# Scripts are developer files, except one the manual tells users to run.
/scripts/*
!/scripts/tcpip_acquisition_replay.groovy

# per-operation logs written next to the data, never part of the source tree
*.log
*.log.lck

# Python bytecode, written beside any script that is imported
__pycache__/

# The Aliasing Resampling evaluation's developer-only parity check against the SciPy
# reconstruction, whose fixtures the local evaluation scripts write
/src/test/java/de/embl/iclm/AliasingScipyParityTest.java
